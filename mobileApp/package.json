{
  "name": "schooladmin-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --host localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas": "node node_modules/eas-cli/bin/run",
    "build:android": "node node_modules/eas-cli/bin/run build --platform android --profile preview",
    "build:android:production": "node node_modules/eas-cli/bin/run build --platform android --profile production",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~49.0.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "react-native-screens": "~3.22.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-gesture-handler": "2.12.0"
  },
  "devDependencies": {
    "eas-cli": "^20.0.0",
    "jest": "^29.6.1",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ]
  }
}
